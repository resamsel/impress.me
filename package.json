{
  "name": "impress.me",
  "description": "Create impress.js presentations from markdown documents with style",
  "version": "0.13.0",
  "author": "René Panzar",
  "bin": {
    "impress.me": "./bin/run"
  },
  "bugs": "https://github.com/resamsel/impress.me/issues",
  "dependencies": {
    "@oclif/command": "1.8.36",
    "@oclif/config": "1.18.17",
    "@oclif/errors": "1.3.6",
    "@oclif/plugin-help": "6.2.56",
    "clean-css": "^5.3.3",
    "highlight.js": "11.11.1",
    "impress.js": "^1.1.0",
    "js-yaml": "5.2.3",
    "lodash": "4.18.1",
    "loglevel": "1.9.2",
    "marked": "18.0.9",
    "open": "11.0.0",
    "pug": "^3.0.4",
    "sass": "1.102.0",
    "sync-request": "6.1.0",
    "tslib": "2.8.1",
    "uglify-es": "^3.3.9",
    "viz.js": "^2.1.2"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@oclif/dev-cli": "1.26.10",
    "@oclif/test": "4.1.21",
    "@storybook/html": "10.5.7",
    "@types/chai": "5.2.3",
    "@types/clean-css": "4.2.11",
    "@types/js-yaml": "4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.1.2",
    "@types/pug": "^2.0.10",
    "@types/uglify-es": "^3.0.3",
    "babel-loader": "10.1.1",
    "capture-website": "5.1.0",
    "chai": "6.2.2",
    "eslint": "^10.8.0",
    "eslint-config-oclif": "^7.1.1",
    "eslint-config-oclif-typescript": "^3.1.14",
    "material-colors": "^1.2.6",
    "mocha": "11.8.0",
    "nyc": "18.0.0",
    "stylelint": "17.14.1",
    "stylelint-config-sass-guidelines": "13.0.0",
    "ts-node": "10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=10.1.0"
  },
  "files": [
    "/bin",
    "/lib",
    "/templates",
    "/css",
    "/js"
  ],
  "homepage": "https://github.com/resamsel/impress.me",
  "keywords": [
    "impress.js",
    "markdown",
    "presentation",
    "html"
  ],
  "license": "ISC",
  "main": "lib/index.js",
  "oclif": {
    "bin": "impress.me"
  },
  "repository": "resamsel/impress.me",
  "scripts": {
    "build": "bin/run HelloWorld.md",
    "build:simple": "bin/run Demo.md 'Demo Plain.html' --open",
    "build:complex": "bin/run Demo.md 'Demo Complex.html' --no-flattened --primary=purple --secondary=lightBlue --strategy=linear --shape=rounded --transitionDuration=0 --cssFiles=css/colors.scss",
    "build:demo": "bin/run Demo.md --theme=slides --strategy=row --shape=square --debug --open",
    "build:slides-01": "bin/run 'examples/Slides 01.md' --debug",
    "build:slides-flattened": "bin/run 'examples/Slides Flattened.md' --debug",
    "build:slides-unexpected": "bin/run 'test/fixtures/markdowns/Slides Unexpected Heading.md' --debug",
    "build:slides-special-char": "bin/run 'test/fixtures/markdowns/Slides Special Character Heading.md' --debug",
    "build:demo2": "bin/run 'examples/Demo 2.md' --primary=blue --secondary=amber --theme=planet --debug",
    "build:demo5": "bin/run 'examples/Demo 5.md' --primary=blue --secondary=amber --theme=planet --debug",
    "build:demo16": "bin/run 'examples/Demo 16.md' --primary=blue --secondary=amber --theme=planet --debug",
    "build:readme": "bin/run README.md --primary=blue --secondary=purple --debug",
    "build:examples": "mkdir -p dist/examples; for i in examples/*.md; do echo \"impress.me $i\"; bin/run \"$i\" dist/\"$i\".html --primary=blue --secondary=orange --strategy=planet --shape=circle; done",
    "build:rendercode": "mkdir -p dist/examples; bin/run \"examples/Render Code.md\" dist/\"Render Code\".html --primary=blue --secondary=orange --strategy=planet --shape=circle --debug",
    "build:newspaper": "bin/run Demo.md --theme=newspaper 'Demo Newspaper.html'",
    "build:stories": "npm run generate:gallery && npm run build:examples && npm run generate:stories",
    "prebuild:storybook": "npm run build:stories",
    "build:storybook": "yarn build-storybook -o docs -s ./dist/examples,./dist/gallery",
    "storybook": "start-storybook -s ./dist/examples,./dist/gallery -p 9001",
    "pretest": "npm run lint",
    "test": "nyc --extension .ts mocha --require ts-node/register --forbid-only 'test/**/*.test.ts'",
    "lint": "eslint 'src/**/*.ts' && stylelint 'css/*.scss'",
    "lint:fix": "eslint 'src/**/*.ts' --fix && stylelint 'css/*.scss' --fix",
    "generate:colors": "ts-node scripts/generate-colors.ts",
    "generate:gallery": "ts-node scripts/generate-gallery.ts",
    "generate:stories": "ts-node scripts/generate-stories.ts",
    "prepack": "rm -rf lib && tsc -b && oclif-dev readme",
    "version": "oclif-dev readme && git add README.md",
    "release:patch": "npm run test && npm version patch && npm publish",
    "release:minor": "npm run test && npm version minor && npm publish",
    "release:major": "npm run test && npm version major && npm publish"
  },
  "types": "lib/index.d.ts"
}
